{
  "name": "devdock",
  "version": "0.4.1",
  "description": "Personal developer workspace with GitHub integration",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:arm64": "npm run build && electron-builder --win nsis --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "predev": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "sharp": "^0.35.4",
    "png-to-ico": "^3.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "dev.devdock.personal",
    "productName": "DEVDОCK",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "artifactName": "DEVDОCK-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DEVDOCK",
      "runAfterFinish": true
    }
  }
}
